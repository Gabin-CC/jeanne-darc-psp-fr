  "fr": "Nrrrrrngh..."
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Hee hee...!\nPrepare to die!",
  "fr": "Hi hi... !\nTu vas mourir !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "We don't need\na savior!",
  "fr": "Pas besoin\nde salvatrice !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Hee hee! Push\nforward!",
  "fr": "Hi hi ! En\navant !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Hmph...",
  "fr": "Hmph..."
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "unité#164",
  "en": "Geh...",
  "fr": "Geh..."
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Hee hee...\nWrithe in pain!",
  "fr": "Hi hi...\nSouffre donc !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Want me to make\nit all better?",
  "fr": "Tu veux que je\nte soigne ?"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Pahh!",
  "fr": "Pahh !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Gah!",
  "fr": "Gah !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "I'll run\nyou over!",
  "fr": "Je vais\nt'écraser !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Tell me how\nthis tastes!",
  "fr": "Ça a quel\ngoût, hein ?"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "You...are my\nenemy!",
  "fr": "Tu... es mon\nennemi !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Damn you...",
  "fr": "Maudit sois-tu..."
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "You will not\ndestroy us!",
  "fr": "Vous ne nous\ndétruirez pas !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Dammit...we\ncan't take 'em.",
  "fr": "Bon sang... ils\nsont trop forts."
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Why did you\ncome here?!",
  "fr": "Pourquoi être\nvenus ici ?!"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "We'll protect\nthis town!",
  "fr": "Nous défendrons\ncette ville !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "We have no need\nfor a savior!",
  "fr": "Pas besoin\nd'une salvatrice !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Go back to\nwhence you came!",
  "fr": "Retournez\nd'où vous venez !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Savior, my foot!",
  "fr": "Salvatrice,\nmon œil !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Just a common\nmurderer!",
  "fr": "Une vulgaire\nmeurtrière !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "No regrets,\nI hope.",
  "fr": "Pas de regrets,\nj'espère."
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "All right! Clear\nthem out!",
  "fr": "Parfait !\nBalayez-les !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "unité#150",
  "en": "Get 'em!",
  "fr": "Attrapez-les !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Ergh...I cannot\nlose!",
  "fr": "Argh... je ne\npeux pas perdre !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Agh...you...\nHow are you...?",
  "fr": "Agh... toi...\nComment as-tu... ?"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Raaagh!",
  "fr": "Raaagh !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "I'll handle\nthis!",
  "fr": "Je m'en charge !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Face your shame!",
  "fr": "Affronte\nta honte !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Clear them\nout, now!",
  "fr": "Balayez-les,\nmaintenant !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Gilles",
  "en": "Richard! Why?",
  "fr": "Richard !\nPourquoi ?"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Gilles",
  "en": "A righteous man like you\\u2014",
  "fr": "Un homme juste\ncomme vous\\u2014"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Richard",
  "en": "Not all men wish for the same\nfuture as you.",
  "fr": "Tous ne souhaitent pas le même\navenir que vous."
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Richard",
  "en": "It is well past time you learnt\nthat lesson.",
  "fr": "Il était grand temps que vous\nl'appreniez."
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Gilles",
  "en": "...Look, his arm!",
  "fr": "...Regardez,\nson bras !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Jeanne",
  "en": "Another armlet wielder?!",
  "fr": "Un autre porteur\nde Bracelet ?!"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Richard",
  "en": "As I said, not all men wish for\nthe same future as you.",
  "fr": "Je le répète : tous ne souhaitent\npas le même avenir que vous."
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Richard",
  "en": "But I have faith...",
  "fr": "Mais j'ai foi..."
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Richard",
  "en": "I have faith:",
  "fr": "J'ai foi :"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Richard",
  "en": "that the peaceful world I wish for\nlies in a unified France!",
  "fr": "le monde de paix que je désire passe\npar une France unifiée !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Slinker",
  "en": "Ni-niii!\nWhat are you doing?!",
  "fr": "Ni-niii !\nQue fais-tu ?!"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Jeanne, Liane",
  "en": "Richard!",
  "fr": "Richard !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Richard",
  "en": "Fight with me\\u2014for this\ncountry's future!",
  "fr": "Battons-nous\\u2014pour\nl'avenir du pays !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Richard",
  "en": "Richard joins your ranks!",
  "fr": "Richard rejoint\nvos rangs !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Jeanne",
  "en": "Richard!\nExplain yourself!",
  "fr": "Richard !\nExpliquez-vous !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Jeanne",
  "en": "How could you deceive me?",
  "fr": "Comment avez-vous\npu me tromper ?"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Jeanne",
  "en": "...Your arm!",
  "fr": "...Votre bras !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Jeanne",
  "en": "Richard wields an armlet, like\nus...",
  "fr": "Richard porte un Bracelet, comme\nnous..."
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Jeanne",
  "en": "But then why?",
  "fr": "Mais alors,\npourquoi ?"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Slinker",
  "en": "Ni-aaaaaagh!\nHow d-d-dare youuuu, ni!",
  "fr": "Ni-aaaaaargh !\nTu o-o-oses, ni ?!"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "Slinker",
  "en": "Next time...you won't be so\nlucky!",
  "fr": "La prochaine fois, tu n'auras\npas autant de chance !"
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "",
  "en": "Reims is a long ways off. Next is the city of Ch\\u00e2lons.",
  "fr": "Reims est encore loin. Prochaine\nétape : la ville de Ch\\u00e2lons."
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "Mayor of Troyes",
  "en": "We surrender...",
  "fr": "Nous nous rendons..."
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "Mayor of Troyes",
  "en": "The citizens of Troyes will swear\nfealty to the dauphin,",
  "fr": "Les citoyens de Troyes jureront\nfidélité au Dauphin,"
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "Mayor of Troyes",
  "en": "and join his army in opposing\nthe English.",
  "fr": "et rejoindront son armée contre\nles Anglais."
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "Jeanne",
  "en": "...Why did you do this!",
  "fr": "...Pourquoi avoir fait ça !"
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "Jeanne",
  "en": "Why do we have to fight each\nother?!",
  "fr": "Pourquoi devons-nous nous battre\nentre nous ?!"
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "Jeanne",
  "en": "Frenchmen shouldn't have to kill\nFrenchmen!",
  "fr": "Des Français ne devraient pas tuer\nd'autres Français !"
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "Richard",
  "en": "Ah, but you have no qualms about\nkilling Englishmen?",
  "fr": "Ah, mais tuer des Anglais ne vous\ngêne guère ?"
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "Richard",
  "en": "The English royal family descends\nfrom a people exiled from France;",
  "fr": "La famille royale anglaise descend\nd'un peuple exilé de France ;"
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "Richard",
  "en": "in other words, they share the\nsame French blood as you and I.",
  "fr": "autrement dit, elle partage le même\nsang français que vous et moi."
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "Richard",
  "en": "This is no war between countries.",
  "fr": "Ce n'est pas une guerre de nations."
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "Richard",
  "en": "It's a glorified family feud,",
  "fr": "Ce n'est qu'une querelle de famille\nà grande échelle,"
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "Richard",
  "en": "between consanguineous nobles\nsquabbling over lands and titles.",
  "fr": "entre nobles consanguins qui se\ndisputent terres et titres."
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "Jeanne",
  "en": "...No, it can't be.",
  "fr": "...Non, c'est impossible."
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "Jeanne",
  "en": "Lass...do you really believe you\ncan save all of France's people?",
  "fr": "Petite... tu crois vraiment pouvoir\nsauver tout le peuple de France ?"
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "Jeanne",
  "en": "Innocent people are...are dying\nfor that? All this time...",
  "fr": "Des innocents... meurent pour ça ?\nDepuis tout ce temps..."
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "Jeanne",
  "en": "we've been fighting to sate the\nroyalty's hunger for power?",
  "fr": "on se battait pour assouvir la\nsoif de pouvoir des rois ?"
 },
 {
  "ctx": "ST2070AB",
  "max": 34,
  "who": "",
  "en": "One day...you'll learn just how\nabsurd a place the world really is.",
  "fr": "Un jour... tu comprendras à quel\npoint le monde est absurde."
 },
 {
  "ctx": "ST2080BM",
  "max": 34,
  "who": "",
  "en": "&Mayor of Châlons",
  "fr": "&Maire de Châlons"
 },
 {
  "ctx": "ST2080BM",
  "max": 34,
  "who": "Mayor of Châlons",
  "en": "I cannot challenge the Pucelle.",
  "fr": "Je ne peux pas défier la Pucelle."
 },
 {
  "ctx": "ST2080BM",
  "max": 34,
  "who": "Mayor of Châlons",
  "en": "We'd never win. I have no choice\nbut to surrender the city.",
  "fr": "Jamais nous ne vaincrions. Je n'ai\nplus qu'à rendre la ville."
 },
 {
  "ctx": "ST2080BM",
  "max": 34,
  "who": "Slinker",
  "en": "Ni! Won't fight the filly, you say?",
  "fr": "Ni ! Tu refuses d'affronter la\npouliche, dis-tu ?"
 },
 {
  "ctx": "ST2080BM",
  "max": 34,
  "who": "Slinker",
  "en": "Then you won't mind me taking\nmatters into my own claws.",
  "fr": "Alors tu ne m'en voudras pas de\nprendre les choses en griffes."
 },
 {
  "ctx": "ST2080BM",
  "max": 34,
  "who": "Mayor of Châlons",
  "en": "Ngaaah!",
  "fr": "Ngaaah !"
 },
 {
  "ctx": "ST2080BM",
  "max": 34,
  "who": "",
  "en": "&Citizen",
  "fr": "&Habitant"
 },
 {
  "ctx": "ST2080BM",
  "max": 34,
  "who": "Citizen",
  "en": "Mayor!",
  "fr": "Monsieur le Maire !"
 },
 {
  "ctx": "ST2080BM",
  "max": 34,
  "who": "Slinker",
  "en": "Murder her.\fShe'd never bare a blade at you\ncommon folk...",
