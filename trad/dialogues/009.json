  "fr": "Hé hé hé..."
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Hee hee hee!",
  "fr": "Hi hi hi !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "You bastards...!",
  "fr": "Bande de\nchiens... !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Erp...!",
  "fr": "Heup... !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "You...damn you!",
  "fr": "Toi... que le\ndiable t'emporte !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
  "en": "Gah...everyone,\nstay on target!",
  "fr": "Gah... tous,\ngardez le cap !"
 },
 {
  "ctx": "ST2070BT",
  "max": 16,
  "who": "",
