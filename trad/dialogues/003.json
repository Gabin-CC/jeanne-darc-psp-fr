[
 {
  "ctx": "ST1040AB",
  "max": 34,
  "who": "French Soldier",
  "en": "Now then, we'd best be off to \nthe castle in Nancy.",
  "fr": "Bien, nous ferions mieux de partir\npour le château de Nancy."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "",
  "en": "First, we must cross Soir Valley to get to Chinon.",
  "fr": "Traversez la vallée de Soir\njusqu'à Chinon."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "French Soldier",
  "en": "The duke is ill.",
  "fr": "Le duc est souffrant."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "French Soldier",
  "en": "Please take care while you and \nhe have your talk.",
  "fr": "Je vous prie de le ménager\npendant votre entretien."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "You?!",
  "fr": "Vous ?!"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Nobleman",
  "en": "Duke, I must be on my way.",
  "fr": "Monseigneur, je dois prendre congé."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Wait!",
  "fr": "Attendez !"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Why are you here?",
  "fr": "Que faites-vous ici ?"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "",
  "en": "&Gilles",
  "fr": "&Gilles"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "...My name is Gilles de Rais.",
  "fr": "...Je me nomme Gilles de Rais."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "Might I ask yours?",
  "fr": "Puis-je connaître votre nom ?"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...It's Jeanne.",
  "fr": "...Jeanne."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "Well, Jeanne...don't worry.\nI know how to find you.",
  "fr": "Eh bien, Jeanne... rassurez-vous.\nJe saurai vous retrouver."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne, Liane",
  "en": "Huh?",
  "fr": "Hein ?"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "French Soldier",
  "en": "Pucelle, step forward.",
  "fr": "Pucelle, approchez."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "",
  "en": "&Duke of Lorraine",
  "fr": "&Duc de Lorraine"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "Our savior...",
  "fr": "Notre salvatrice..."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "Here she is, come clad in a \nholy armlet.",
  "fr": "La voici, parée d'un\nBracelet sacré."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "Let me see it.",
  "fr": "Montrez-le-moi."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...Your Grace.",
  "fr": "...Votre Grâce."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "...It's real.",
  "fr": "...Il est authentique."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "Yours is a legendary armlet \nreputed to have saved the world.",
  "fr": "C'est un Bracelet légendaire qui,\ndit-on, a sauvé le monde."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "It represents an oath,\fthat France's future never go \nundefended.",
  "fr": "Il incarne un serment :\fque l'avenir de la France ne soit\njamais sans défenseur."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "This armlet chose you, Jeanne.",
  "fr": "Ce Bracelet vous a choisie, Jeanne."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Then I am to save France?",
  "fr": "Je dois donc sauver la France ?"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "To be frank, I called you here \nout of hope...",
  "fr": "À vrai dire, je vous ai fait venir\ndans l'espoir..."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "that you might use the armlet's \npower to chase the sickness \nfrom my body.",
  "fr": "que le pouvoir du Bracelet chasse\nla maladie de mon corps."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Your Grace, that's\\u2014",
  "fr": "Votre Grâce, c'est\\u2014"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "Impossible. I know.",
  "fr": "Impossible. Je sais."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "A few extra years tacked on to \none decrepit old man's life...",
  "fr": "Quelques années de plus pour\nun vieillard décrépit..."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "would hardly change the course \nof French history.",
  "fr": "ne changeraient guère le cours\nde l'histoire de France."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "Gilles, that man who was here \nbefore, told me as much.",
  "fr": "Gilles, l'homme qui était ici,\nme l'a dit lui-même."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "He said that?",
  "fr": "Il a dit ça ?"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "My time is passed;\fnow that I've looked upon you, \nI find I can accept that.",
  "fr": "Mon temps est passé ;\fmaintenant que je vous ai vue,\nje peux l'accepter."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "But just once before I die, \nI want to see France at peace.",
  "fr": "Mais avant de mourir, je voudrais\nvoir la France en paix, une fois."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "I want to drift off, \nconscience clear, \nto the sound of birds...",
  "fr": "Je voudrais m'endormir,\nla conscience tranquille,\nau chant des oiseaux..."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Bedford, Jeanne",
  "en": "Your Grace...",
  "fr": "Votre Grâce..."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Cuisses, Duke of Lorraine, Roger",
  "en": "Jeanne.",
  "fr": "Jeanne."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "Save France. Do it for me.",
  "fr": "Sauvez la France. Pour moi."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "And do it for all the people \nof France.",
  "fr": "Et pour tout le peuple de France."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "Goad the dauphin out of that \ncastle cocoon of his in Chinon,",
  "fr": "Tirez le Dauphin de ce cocon\nqu'est son château de Chinon,"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "and reclaim the lands of France \nfrom the clutches of the English.",
  "fr": "et arrachez les terres de France\naux griffes des Anglais."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...You needn't even ask.",
  "fr": "...Vous n'avez même pas à le\ndemander."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "",
  "en": "...SAVE FRANCE...",
  "fr": "...SAUVE LA FRANCE..."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "...Is something the matter?",
  "fr": "...Quelque chose ne va pas ?"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "No...nothing.",
  "fr": "Non... rien."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "You'll do as I ask, won't you, \nJeanne?",
  "fr": "Vous ferez ce que je vous demande,\nn'est-ce pas, Jeanne ?"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Roger",
  "en": "Ahh...!",
  "fr": "Ah... !"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Roger",
  "en": "Just a dream...",
  "fr": "Ce n'était qu'un rêve..."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Cuisses",
  "en": "Zzzzzz...\nCoa-wa-wa-wa-wah...",
  "fr": "Zzzzzz... Croa-oua-oua-oua-ouah..."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...What are you doing up, Roger?",
  "fr": "...Qu'est-ce que tu fais debout,\nRoger ?"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Are you all right? I heard you \ncry out.",
  "fr": "Ça va ? Je t'ai entendue crier."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Roger",
  "en": "I had a dream. An awful one...",
  "fr": "J'ai fait un rêve. Un rêve affreux."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Roger",
  "en": "Jeanne...what about you?\nAre you all right?",
  "fr": "Jeanne... et toi, alors ?\nTu tiens le coup ?"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Roger",
  "en": "You look terrible. Like you \nhaven't slept for days.",
  "fr": "Tu as une mine affreuse. On dirait\nque tu n'as pas dormi de la semaine."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...I haven't. How could I sleep? \nThere's so much on my mind.",
  "fr": "...C'est le cas. Comment dormir ?\nJ'ai tant de choses en tête."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Roger",
  "en": "Listen, Jeanne...",
  "fr": "Écoute, Jeanne..."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Roger",
  "en": "Why don't we go home?\nI know even Liane\\u2014",
  "fr": "Et si on rentrait à la maison ?\nMême Liane, je sais\\u2014"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "It's Gilles. Sorry to disturb \nyou at this ungodly hour.",
  "fr": "C'est Gilles. Pardonnez-moi de vous\ndéranger à une heure si indue."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "I'll be departing soon for Chinon.",
  "fr": "Je pars bientôt pour Chinon."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "Are you coming, Jeanne?",
  "fr": "Venez-vous, Jeanne ?"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne, Roger, Gilles",
  "en": "...What?",
  "fr": "...Quoi ?"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "Surely the duke told you?",
  "fr": "Le duc vous l'a sûrement dit ?"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "...Don't you plan to meet with \nthe dauphin?",
  "fr": "...Ne comptez-vous pas rencontrer\nle Dauphin ?"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "I... I just...",
  "fr": "Je... C'est que..."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "I'm so angry at the English.",
  "fr": "J'en veux tellement aux Anglais."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "All I want is to protect everyone.",
  "fr": "Tout ce que je veux, c'est protéger\ntout le monde."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "I can't think of anything else...",
  "fr": "Je ne pense à rien d'autre..."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "let alone dream of saving France.",
  "fr": "alors rêver de sauver la France..."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "So long as you wear that armlet, \nyou have a duty\\u2014",
  "fr": "Tant que vous portez ce Bracelet,\nvous avez un devoir\\u2014"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "the same duty as the heroes of \nold.",
  "fr": "le même devoir que les héros\nd'antan."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "France is counting on you.",
  "fr": "La France compte sur vous."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "Besides, saving France MEANS \nprotecting everyone.",
  "fr": "D'ailleurs, sauver la France, c'EST\nprotéger tout le monde."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "I can't do it... Not me.",
  "fr": "Je ne peux pas... Pas moi."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "I don't even know how to use \nthe armlet right.",
  "fr": "Je ne sais même pas bien me servir\ndu Bracelet."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "I couldn't protect my village \nor the townsmen or anything!",
  "fr": "Je n'ai pu protéger ni mon village,\nni les habitants, ni rien !"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "...But you can save France.",
  "fr": "...Mais vous, vous le pouvez."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "Somehow I just know it.",
  "fr": "Je le sais, sans savoir comment."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "And you did protect something.\nYou saved my life.",
  "fr": "Et vous avez protégé quelque chose.\nVous m'avez sauvé la vie."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "I'll be waiting in Chinon.",
  "fr": "Je vous attendrai à Chinon."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "I, at least, am ready to lay \ndown my life for Mother France.",
  "fr": "Pour ma part, je suis prêt à donner\nma vie pour notre mère la France."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Roger",
  "en": "I'll go wherever you go.\nNo matter what you decide...",
  "fr": "J'irai où tu iras.\nQuoi que tu décides..."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Roger",
  "en": "I'll protect you, I swear it.",
  "fr": "Je te protégerai, je le jure."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne, Liane, unité#31",
  "en": "Roger...",
  "fr": "Roger..."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Liane",
  "en": "Jeanne! I'm sorry...",
  "fr": "Jeanne ! Pardon..."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne, Roger",
  "en": "Liane?",
  "fr": "Liane ?"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Liane",
  "en": "I won't cry or complain anymore.\fI'll stick with the two of you as \nlong as it takes!",
  "fr": "Je ne pleurerai plus, je ne me\nplaindrai plus.\fJe resterai avec vous deux aussi\nlongtemps qu'il le faudra !"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Liane... I-I'm sorry.",
  "fr": "Liane... P-pardon."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "The road to Chinon is long \nand severe.",
  "fr": "La route de Chinon est longue\net rude."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "In time of danger, I trust these \ntwo will serve you well.",
  "fr": "En cas de danger, ces deux-là vous\nserviront bien, j'en suis sûr."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "Go on, introduce yourselves.",
  "fr": "Allez, présentez-vous."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Colet",
  "en": "Salut.",
  "fr": "Salut."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Marcel",
  "en": "Nice to meetcha!",
  "fr": "Ravi de te connaître !"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "You've made a difficult choice,\nJeanne...",
  "fr": "Vous avez fait un choix difficile,\nJeanne..."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Duke of Lorraine",
  "en": "and the right one. \nGod be with you.",
  "fr": "et le bon. Que Dieu vous garde."
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "",
  "en": "Colet joins your ranks!",
  "fr": "Colet rejoint vos rangs !"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "",
  "en": "Marcel joins your ranks!",
  "fr": "Marcel rejoint vos rangs !"
 },
 {
  "ctx": "ST1050BM",
  "max": 34,
  "who": "Colet",
  "en": "I swear, ze old duke must have\nfinally gone gaga.",
  "fr": "Ma parole, le vieux duc est\nenfin devenu gaga, sacrebleu."
 },
 {
  "ctx": "ST1050BM",
  "max": 34,
  "who": "Colet",
  "en": "Such a woman haz no business\nmeeting weez ze dauphin.",
  "fr": "Une femme pareille n'a rien à\nfaire chez le Dauphin. Scandaleux !"
 },
 {
  "ctx": "ST1050BM",
  "max": 34,
  "who": "Colet",
  "en": "Et mon dieu! He sent a leetle\nboy to be her bodyguard.",
  "fr": "Et mon Dieu ! Il lui a donné un\npetit garçon comme garde du corps."
 },
 {
  "ctx": "ST1050BM",
  "max": 34,
  "who": "Marcel",
  "en": "Ooh, look, Colette! The flowers\nhere are so peculiar.",
  "fr": "Oh, regarde, Colette ! Les fleurs\nsont si bizarres, ici."
 },
 {
  "ctx": "ST1050BM",
  "max": 34,
  "who": "Colet",
  "en": "Zat's \"Co-lay,\" not \"Co-lette\"!\fDo I look like a woman? Do I\nhave ze pigtails? Non!",
  "fr": "C'est « Colet », pas « Colette » !\fJ'ai l'air d'une femme ? J'ai des\ncouettes, peut-être ? Non !"
 },
 {
  "ctx": "ST1050BM",
  "max": 34,
  "who": "Colet",
  "en": "And leave ze peculiar objects\nalone before you catch somezing!",
  "fr": "Et ne touche pas aux trucs bizarres\navant d'attraper une saleté !"
 },
 {
  "ctx": "ST1050BM",
  "max": 34,
  "who": "Colet",
  "en": "Heh! Talk about ze wilderness.\nZere eez nary a soul een sight!",
  "fr": "Heh ! Quel trou perdu, mon ami.\nPas une âme en vue !"
 },
 {
  "ctx": "ST1050BM",
  "max": 34,
  "who": "Colet",
  "en": "No wonder zey call zees place ze\n\"land of ze lost.\"",
  "fr": "Pas étonnant qu'on appelle ce\nlieu le « pays des égarés »."
 },
 {
  "ctx": "ST1050BM",
  "max": 34,
  "who": "Colet",
  "en": "Perfect for a fwightened\npwinceling to hide out, non?",
  "fr": "Parfait pour qu'un petit prince\npeureux s'y cache, non ?"
 },
 {
  "ctx": "ST1050BM",
  "max": 34,
  "who": "Colet",
  "en": "I hear you are quite ze lucky\nlady, \"Pucelle\"...",
  "fr": "Il paraît que vous êtes une dame\nbien chanceuse, « Pucelle »..."
 },
 {
  "ctx": "ST1050BM",
  "max": 34,
