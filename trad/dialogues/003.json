  "fr": "Que faites-vous ici ?",
  "src": "pinky"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "",
  "en": "&Gilles",
  "fr": "&Gilles",
  "src": "pinky"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "...My name is Gilles de Rais.",
  "fr": "... Mon nom est Gilles de Rais.",
  "src": "pinky"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "Might I ask yours?",
  "fr": "Puis-je vous demander le vôtre ?",
  "src": "pinky"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...It's Jeanne.",
  "fr": "... C'est Jeanne.",
  "src": "pinky"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Gilles",
  "en": "Well, Jeanne...don't worry.\nI know how to find you.",
  "fr": "Eh bien, Jeanne... ne vous en\nfaites pas. Je sais où vous trouver.",
  "src": "pinky"
 },
 {
  "ctx": "ST1041BM",
  "max": 34,
  "who": "Jeanne, Liane",
