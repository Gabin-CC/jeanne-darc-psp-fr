 },
 {
  "ctx": "ST3051BM",
  "max": 34,
  "who": "Jeanne",
  "en": "But...what else am I supposed to\ndo?!",
  "fr": "Mais... Qu'est-ce que je pourrais\nfaire d'autre alors ?",
  "src": "pinky",
  "relu": true
 },
 {
  "ctx": "ST3051BM",
  "max": 34,
  "who": "Richard",
  "en": "Jeanne, please...\nFrance is in peril\\u2014\fnay, the whole world.",
  "fr": "Jeanne, s'il te plaît...\nLa France est en danger...\fPire, le monde entier.",
  "src": "pinky"
 },
 {
  "ctx": "ST3051BM",
  "max": 34,
  "who": "Gilles",
  "en": "...Jeanne, I would like to arrange\nfor you to meet with someone.\fIs that all right?",
  "fr": "...Jeanne, je voudrais t'organiser\nun entretien avec quelqu'un.\fTu es d'accord ?",
  "src": "pinky"
 },
 {
  "ctx": "ST3052BM",
  "max": 34,
  "who": "",
  "en": "Cross the Cents-Abris Ruins to meet the Duke.",
  "fr": "Traverser les ruines de\nCents-Abris.",
  "src": "pinky"
 },
 {
  "ctx": "ST3052BM",
  "max": 34,
  "who": "French Soldier",
  "en": "Beggin' your pardon, sir.",
