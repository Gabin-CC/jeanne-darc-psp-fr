 },
 {
  "ctx": "ST3051BM",
  "max": 34,
  "who": "Cuisses",
  "en": "Yes\\u2014and the Fiend himself,\fhe sleeps within none other\nthan Henry VI!",
  "fr": "Oui...\fet le Démon en personne est\nendormi dans le corps de Henry\fVI lui-même !",
  "src": "pinky"
 },
 {
  "ctx": "ST3051BM",
  "max": 34,
  "who": "Gilles",
  "en": "This is a catastrophe...",
  "fr": "C'est une catastrophe...",
  "src": "pinky"
 },
 {
  "ctx": "ST3051BM",
  "max": 34,
  "who": "Cuisses",
  "en": "Only the armlets' holy power can\ndefeat the reapers\\u2014",
  "fr": "Seul le saint pouvoir des bracelets\npeut détruire les moissonneurs...",
  "src": "pinky",
  "relu": true
 },
 {
  "ctx": "ST3051BM",
  "max": 34,
  "who": "Cuisses",
  "en": "so Luther has been busy looking\nfor them and their wielders.",
  "fr": "ainsi Luther a été occupé à les\nchercher, eux et leurs porteurs.",
  "src": "pinky"
 },
 {
  "ctx": "ST3051BM",
  "max": 34,
  "who": "Richard",
  "en": "...Let me ask you one thing.\nHow many armlets are there?",
  "fr": "J'ai une question à te poser...\nCombien de bracelets y a-t-il ?",
  "src": "pinky"
 },
 {
  "ctx": "ST3051BM",
  "max": 34,
  "who": "Cuisses",
  "en": "...Five in total.",
  "fr": "Cinq en tout.",
