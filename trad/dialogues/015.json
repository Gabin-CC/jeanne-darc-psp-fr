  "src": "pinky"
 },
 {
  "ctx": "ST3051BM",
  "max": 34,
  "who": "Cuisses",
  "en": "and as for the last\\u2014",
  "fr": "Quant au dernier...",
  "src": "pinky"
 },
 {
  "ctx": "ST3051BM",
  "max": 34,
  "who": "Gilles",
  "en": "Jeanne, where are you going?",
  "fr": "Jeanne, où vas-tu ?",
  "src": "pinky"
 },
 {
  "ctx": "ST3051BM",
  "max": 34,
  "who": "Jeanne",
  "en": "To find Roger!\nI have to change him back!",
  "fr": "Chercher Roger !\nJe dois le ramener !",
