  "who": "Richemont",
  "en": "No, I'm glad you're here.",
  "fr": "Non, votre présence m'enchante.",
  "src": "pinky"
 },
 {
  "ctx": "ST3052BM",
  "max": 34,
  "who": "Richemont",
  "en": "...So it's true.",
  "fr": "... Alors c'est vrai.",
  "src": "pinky"
 },
 {
  "ctx": "ST3052BM",
  "max": 34,
  "who": "Richemont",
  "en": "Much about your journey had\nalready reached my ears.",
