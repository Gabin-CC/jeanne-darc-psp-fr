  "max": 34,
  "who": "French Soldier",
  "en": "Sir Gilles is waitin' outside.",
  "fr": "Ser Gilles attend dehors.",
  "src": "pinky"
 },
 {
  "ctx": "ST3052BM",
  "max": 34,
  "who": "Richemont",
  "en": "...See him in.",
  "fr": "Faites-le entrer.",
