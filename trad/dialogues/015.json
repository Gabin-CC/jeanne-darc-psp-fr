  "src": "pinky"
 },
 {
  "ctx": "ST3052BM",
  "max": 34,
  "who": "Richemont",
  "en": "Right now Georges is the king's\nhand, and Georges will not act.",
  "fr": "Pour l'heure Georges est la main\ndu Roi, et il n'agira pas.",
  "src": "pinky"
 },
 {
  "ctx": "ST3052BM",
  "max": 34,
  "who": "Richemont",
