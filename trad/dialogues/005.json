[
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Liane",
  "en": "Listen to that applause!",
  "fr": "Écoutez-moi ces applaudissements !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Liane",
  "en": "I can't believe we're in the same\nroom we were ten minutes ago.",
  "fr": "Dire qu'on est dans la même salle\nqu'il y a dix minutes..."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Roger",
  "en": "Neither can I.",
  "fr": "Je n'en reviens pas non plus."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Georges",
  "en": "He'th really mucked thingth up\nnow...",
  "fr": "Il a vraiment tout gâché,\ncette fois..."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Roger",
  "en": "...Ah...",
  "fr": "...Ah..."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Georges",
  "en": "Bathtard dauphin! He should haff\njutht done ath he wath told...",
  "fr": "Maudit dauphin ! Il n'avait qu'à\nfaire ze qu'on lui avait dit..."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Roger",
  "en": "...Ungh...gahhh...",
  "fr": "...Ngh... gaaah..."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Liane, Roger",
  "en": "Ahhhhh!",
  "fr": "Aaaaah !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Roger",
  "en": "That dream again...",
  "fr": "Encore ce rêve..."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...And now they all think I'm\ntheir Pucelle.",
  "fr": "...Et maintenant, tout le monde\nme prend pour leur Pucelle."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "I don't even hear the Voice\nthat much. Just now and then!",
  "fr": "Je n'entends même pas si souvent\nla Voix. Juste de temps en temps !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "But the fact remains...\fthat you picked the dauphin\nout of that crowd.",
  "fr": "Il n'empêche...\fque vous avez reconnu le dauphin\nau milieu de cette foule."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "He believed in your words and\nyour strength,",
  "fr": "Il a cru en vos paroles et en\nvotre force,"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "and now he's finally going to act.",
  "fr": "et il va enfin passer à l'action."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "Tomorrow we begin preparations\nfor the Orléans campaign.",
  "fr": "Dès demain, nous préparerons\nla campagne d'Orléans."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "I don't know how he expects me\nto lead the relief column.",
  "fr": "Je ne vois pas comment il compte\nme faire mener les renforts."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...Are you sure you don't hear\nthe voice, Gilles?",
  "fr": "...Vous êtes sûr de ne pas entendre\nla Voix, Gilles ?"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "You've got the same armlet as I\ndo.",
  "fr": "Vous avez le même Bracelet que\nmoi."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "When I look at you, Jeanne,\fI find myself just as surprised\nas them.",
  "fr": "Quand je vous regarde, Jeanne, je\nsuis tout aussi surpris qu'eux."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "My armlet was passed down to\nme \nthrough my house, father to son.",
  "fr": "Mon Bracelet s'est transmis\ndans ma famille, de père en fils."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "Just being able to wield the\narmlet's power earned me\na hero's honors.",
  "fr": "Le simple fait de maîtriser son\npouvoir m'a valu des honneurs\nde héros."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "But to think someone out there\ncould hear God's voice!",
  "fr": "Mais de là à imaginer que quelqu'un\npuisse entendre la voix de Dieu !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "I thought for sure you knew...",
  "fr": "J'étais persuadée que vous le\nsaviez..."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "and that was why you were\nfollowing me.",
  "fr": "et que c'était pour cela que\nvous me suiviez."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "How odd. All this time I thought\nI was the one being pursued.",
  "fr": "Comme c'est curieux. Moi qui\ncroyais être celui qu'on suivait."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "",
  "en": "Gilles joins your ranks!",
  "fr": "Gilles rejoint vos rangs !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "I would, um... I'd like to start\nthe war council now...",
  "fr": "Je voudrais, euh... J'aimerais\nouvrir le conseil de guerre..."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "Are you all deaf?",
  "fr": "Vous êtes tous sourds ?"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "We're here to talk war.\fNow let's hear some strategies\nfor taking back Orléans!",
  "fr": "Nous sommes ici pour parler de\nguerre.\fAlors, écoutons vos stratégies\npour reprendre Orléans !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "",
  "en": "&Noble in Black",
  "fr": "&Noble en noir"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Noble in Black",
  "en": "Offer strategies? Pffaw!\nThe battle can't be won!",
  "fr": "Des stratégies ? Peuh !\nCette bataille est perdue d'avance !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "",
  "en": "&Young Noble",
  "fr": "&Jeune noble"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Young Noble",
  "en": "Agreed.\fWhy squander the dauphin's\ntroops on a futile effort?",
  "fr": "D'accord.\fPourquoi gaspiller les troupes du\ndauphin dans une vaine entreprise ?"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Young Noble",
  "en": "Just breaking the English siege\nand entering the city\\u2014",
  "fr": "Rien que briser le siège anglais\net entrer dans la ville\\u2014"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Young Noble",
  "en": "that alone is a dubious enough\nprospect.",
  "fr": "voilà qui est déjà bien hasardeux."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "But...",
  "fr": "Mais..."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "I thought it was already agreed\nwe were marching on Orléans?",
  "fr": "Je croyais qu'il était convenu\nque nous marchions sur Orléans ?"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Noble in Black",
  "en": "Perhaps it would have been...",
  "fr": "Peut-être l'aurait-il été..."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Noble in Black",
  "en": "in the company of an\nexperienced, skilled leader.",
  "fr": "sous les ordres d'un chef\nexpérimenté et compétent."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...You can't be serious!",
  "fr": "...Vous plaisantez !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Enough! I'm going to\nOrléans\\u2014alone if I have to.\fStay behind if you want,\nall of you! See if I care!",
  "fr": "Ça suffit ! J'irai à\nOrléans\\u2014seule s'il le faut.\fRestez ici si ça vous chante,\ntous autant que vous êtes !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Roger",
  "en": "Gilles! Do something!",
  "fr": "Gilles ! Faites quelque chose !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jean",
  "en": "Jeanne, my sweet! Wait!",
  "fr": "Jeanne, ma douce ! Attendez !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...You're still here?",
  "fr": "...Vous êtes encore là ?"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Shouldn't you two be halfway\nback to Vaucouleurs by now?",
  "fr": "Vous ne devriez pas déjà être\nà mi-chemin de Vaucouleurs ?"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jean",
  "en": "A knight's duty is to protect\nthe maid in distress, is it not?\fWe shall stay with you until the\nday you save France.",
  "fr": "Le devoir d'un chevalier n'est-il\npas de protéger la jeune fille ?\fNous resterons à vos côtés jusqu'au\njour où vous sauverez la France."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Bertrand",
  "en": "Heck, that's what they pay us\nfor, right?\nFightin' for the dauphin.",
  "fr": "Et puis, c'est pour ça qu'on est\npayés, non ?\nPour se battre pour le dauphin."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Bertrand...",
  "fr": "Bertrand..."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Come on.",
  "fr": "Allez."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Let's go show them how to win\na castle!",
  "fr": "Allons leur montrer comment on\nremporte un château !"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "",
  "en": "Beast Warrior",
  "fr": "Guerrier-bête"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "",
  "en": "&English Soldier",
  "fr": "&Soldat anglais"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "English Soldier",
  "en": "Enemy reinforcements!\nSquash the bloody frogs!",
  "fr": "Des renforts ennemis ! Écrasez-moi\nces bloody grenouilles !"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Ready, everyone? Charge!",
  "fr": "Tout le monde est prêt ? Chargez !"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "Roger",
  "en": "Jeanne, are you insane?\nWe can't do this alone!",
  "fr": "Jeanne, tu es folle ?\nOn ne peut pas y aller seuls !"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Don't tell me I'm insane!",
  "fr": "Ne me traite pas de folle !"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Now come on!\nWe haven't a second to lose!",
  "fr": "Allez, venez ! Nous n'avons pas une\nseconde à perdre !"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "Jeanne, Liane",
  "en": "Oomph!",
  "fr": "Ouf !"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "La Hire",
  "en": "Rrr?",
  "fr": "Rrr ?"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "Gilles",
  "en": "...Well met, La Hire.\fWhere have you been? A greeting\nwould be nice.",
  "fr": "...Bien le bonjour, La Hire.\fOù étiez-vous donc passé ? Un\nsalut serait de mise."
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "Jeanne",
  "en": "La Hire?",
  "fr": "La Hire ?"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "La Hire",
  "en": "Oh ho! Forrrgive me.",
  "fr": "Oh oh ! Parrrdonne-moi."
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "La Hire",
  "en": "You stand before the great La\nHire,\fproud warrior of the therion race,\nand champion of the dauphin.\nYou will excuse La Hire for being\nlate, Général.",
  "fr": "Tu as devant toi le grand La Hire,\ffier guerrier de la race thérion\net champion du dauphin.\nTu pardonneras son retard à\nLa Hire, Général."
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Oh, so you've come to help.",
  "fr": "Oh, alors tu es venu nous aider."
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "La Hire",
  "en": "Of courrrse! See how La Hire\naches for battle?",
  "fr": "Bien sûrrr ! Vois comme La Hire\nbrûle de combattre !"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "La Hire",
  "en": "You will accept La Hire's thanks\nfor giving him what he aches for!",
  "fr": "Accepte les remerciements de La\nHire pour lui offrir ce combat !"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "Jeanne",
  "en": "I do, and offer mine in return.\nGood hunting, La Hire.",
  "fr": "Je les accepte, et je t'offre les\nmiens. Bonne chasse, La Hire."
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...And your companion?",
  "fr": "...Et ton compagnon ?"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "",
  "en": "&Beast Warrior",
  "fr": "&Guerrier-bête"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "Beast Warrior",
  "en": "R-ruff! Ry n-n-name?",
  "fr": "Ouaf ! R-r-ron nom ?"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "English Soldier",
  "en": "CHARGE!!! Don't let 'em anywhere\nnear the castle!",
  "fr": "CHARGEZ !!! Qu'ils n'approchent\npas du château, by God !"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "Beast Warrior",
  "en": "R'ohhh...",
  "fr": "R'ohhh..."
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Follow me, everyone!\nTime to break this siege!",
  "fr": "Suivez-moi, tout le monde !\nBrisons ce siège !"
 },
 {
  "ctx": "ST1070BM",
  "max": 34,
  "who": "",
  "en": "La Hire joins your ranks!",
  "fr": "La Hire rejoint vos rangs !"
 },
