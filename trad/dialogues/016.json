 },
 {
  "ctx": "ST3070AB",
  "max": 34,
  "who": "Jeanne",
  "en": "Don't say that!\nWe need you alive.",
  "fr": "Ne dites pas ça !\nNous avons besoin de vous."
 },
 {
  "ctx": "ST3070AB",
  "max": 34,
  "who": "Duke of Burgundy",
  "en": "Then please,\nyou must kill HER\\u2014",
  "fr": "Alors je vous en supplie, tuez-LA\\u2014"
 },
 {
  "ctx": "ST3070AB",
  "max": 34,
  "who": "Duke of Burgundy",
  "en": "that vile, horrible snake of a\nwoman!",
  "fr": "cette ignoble, cette immonde\nvipère !"
 },
 {
  "ctx": "ST3070AB",
  "max": 34,
  "who": "Duke of Burgundy",
  "en": "If you don't, I'll, I'll\\u2014",
  "fr": "Sinon, je... je\\u2014"
 },
 {
  "ctx": "ST3070AB",
  "max": 34,
  "who": "Jeanne",
  "en": "What's gotten into you? Who is\nthis woman you speak of?",
  "fr": "Que vous arrive-t-il ? Qui est\ncette femme dont vous parlez ?"
 },
 {
  "ctx": "ST3070AB",
  "max": 34,
  "who": "Duke of Burgundy",
  "en": "France's queen dowager...\nIsabeau...",
  "fr": "La reine douairière de France...\nIsabeau..."
 },
 {
  "ctx": "ST3070AB",
  "max": 34,
  "who": "Jeanne",
  "en": "The former queen?",
  "fr": "L'ancienne reine ?"
 },
 {
  "ctx": "ST3070AB",
  "max": 34,
  "who": "Gilles",
  "en": "Charles VII's mother.",
  "fr": "La mère de Charles VII."
 },
 {
  "ctx": "ST3070AB",
  "max": 34,
  "who": "Charles VII",
  "en": "Mother...",
  "fr": "Mère..."
 },
 {
  "ctx": "ST3070AB",
  "max": 34,
  "who": "Charles VII",
  "en": "Why have you not come to see\nme? Are my sins so many?",
  "fr": "Pourquoi ne venez-vous jamais\nme voir ? Ai-je tant péché ?"
 },
 {
  "ctx": "ST3070AB",
  "max": 34,
  "who": "Charles VII",
  "en": "What must I do to win back your\nlove?",
  "fr": "Que dois-je faire pour regagner\nvotre amour ?"
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "",
  "en": "Georges should be in Chinon. Let us observe him.",
  "fr": "Georges devrait être à Chinon.\nAllons l'observer."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Georges",
  "en": "What? The Duke of Burgundy'th\nreaper hath awoken?",
  "fr": "Quoi ? Le faucheur du duc de\nBourgogne z'est éveillé ?"
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Georges",
  "en": "Continue! Ith the Duke himthelf\nunharmed?",
  "fr": "Continue ! Le duc lui-même\nezt-il zain et zauf ?"
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Georges",
  "en": "...He what?",
  "fr": "...Il a quoi ?"
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Georges",
  "en": "What do you mean,",
  "fr": "Comment ça,"
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Georges",
  "en": "\"Gilvaroth deffoured hith thoul\"?",
  "fr": "« Gilvaroth a dévoré zon âme » ?"
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Georges",
  "en": "I-I neffer thigned up to b-be\ndeffoured!",
  "fr": "Ze n'ai zamais zigné pour me\nfaire dé-dévorer, moi !"
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Jeanne",
  "en": "We spoke to Philip, Duke of\nBurgundy...",
  "fr": "Nous avons parlé à Philippe,\nduc de Bourgogne..."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Jeanne",
  "en": "and he agreed to a truce.",
  "fr": "et il a accepté une trêve."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "Good work.",
  "fr": "Beau travail."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "Did you have him sign an accord\nas I ordered?",
  "fr": "Lui avez-vous fait signer un\naccord, comme je l'ordonnais ?"
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...It's right here.",
  "fr": "...Le voici."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "...Perfect.",
  "fr": "...Parfait."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "I am going to hold on to this\nfor the time being;",
  "fr": "Je vais le conserver pour\nle moment ;"
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "before I can send it to the king,\fI need you to do something for\nme.",
  "fr": "avant de l'envoyer au roi,\fj'ai besoin que vous fassiez\nquelque chose pour moi."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...What, sir?",
  "fr": "...Quoi donc, messire ?"
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "Investigate Georges.",
  "fr": "Enquêtez sur Georges."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "Find out what he's thinking,\nplanning; who he associates with;",
  "fr": "Découvrez ce qu'il pense, ce\nqu'il trame, qui il fréquente,"
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "and, to whom he answers.",
  "fr": "et à qui il obéit."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Jeanne",
  "en": "You think someone is manipulating\nhim?",
  "fr": "Vous pensez que quelqu'un\nle manipule ?"
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "Perhaps this will sound strange\ncoming from me...",
  "fr": "Cela vous semblera peut-être\nétrange venant de moi..."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "but Georges used to be a just,\nrespectable man.",
  "fr": "mais Georges était autrefois\nun homme juste et respectable."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "True, he always had a penchant\nfor sarcasm,",
  "fr": "Certes, il a toujours eu un\npenchant pour le sarcasme,"
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "but he never took to arrogance\nor corruption the way he does\nnow.",
  "fr": "mais jamais il ne s'était\nlaissé aller à l'arrogance\net à la corruption comme à présent."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Gilles",
  "en": "Do you suspect anyone in\nparticular?",
  "fr": "Soupçonnez-vous quelqu'un\nen particulier ?"
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "No, I couldn't say.",
  "fr": "Non, je ne saurais dire."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "Except the ravens...",
  "fr": "Hormis les corbeaux..."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Gilles",
  "en": "...Ravens?",
  "fr": "...Les corbeaux ?"
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "Ravens always used to haunt\nQueen Isabeau's chambers.",
  "fr": "Les corbeaux hantaient autrefois\nles appartements d'Isabeau."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "And now they haunt Georges's...",
  "fr": "Et à présent, ce sont ceux\nde Georges qu'ils hantent..."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Gilles",
  "en": "We will look into it.",
  "fr": "Nous allons nous en occuper."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "A signed accord does little good...",
  "fr": "Un accord signé ne sert\npas à grand-chose..."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "if Georges rips it up before\nthe king can see it.",
  "fr": "si Georges le déchire avant\nque le roi ne puisse le voir."
 },
 {
  "ctx": "ST3071BM",
  "max": 34,
  "who": "Richemont",
  "en": "...Good luck.",
  "fr": "...Bonne chance."
 },
 {
  "ctx": "ST3072BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Hey, Gilles...",
  "fr": "Dites, Gilles..."
 },
 {
  "ctx": "ST3072BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Can we...",
  "fr": "Est-ce qu'on..."
 },
 {
  "ctx": "ST3072BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Do you think we can change him\nback somehow?",
  "fr": "Pensez-vous qu'on puisse le\nfaire redevenir comme avant ?"
 },
 {
  "ctx": "ST3072BM",
  "max": 34,
  "who": "Gilles",
  "en": "...I'm sorry, Jeanne.\nI don't know.",
  "fr": "...Je suis navré, Jeanne.\nJe l'ignore."
 },
 {
  "ctx": "ST3072BM",
  "max": 34,
  "who": "Jeanne",
  "en": "No. It's all right.",
  "fr": "Non. Ce n'est rien."
 },
 {
  "ctx": "ST3072BM",
  "max": 34,
  "who": "Gilles",
  "en": "Unless\\u2014",
  "fr": "À moins que\\u2014"
 },
 {
  "ctx": "ST3072BM",
  "max": 34,
  "who": "Gilles",
  "en": "...Here he comes.\nWe can talk more later.",
  "fr": "...Le voilà.\nNous en reparlerons plus tard."
 },
 {
  "ctx": "ST3072BM",
  "max": 34,
  "who": "Jeanne",
  "en": "He's acting strange...",
  "fr": "Il se comporte bizarrement..."
 },
 {
  "ctx": "ST3072BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Let's go after him.",
  "fr": "Suivons-le."
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Jeanne",
  "en": "What is this place?",
  "fr": "Quel est cet endroit ?"
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Roger",
  "en": "...Where have you been?\nI don't like to be kept waiting.",
  "fr": "...Où étais-tu passé ? Je n'aime\npas qu'on me fasse attendre."
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Gilles",
  "en": "...Shh!",
  "fr": "...Chut !"
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Georges",
  "en": "Goodneth, what a surprithe!\nMy humbleth apologieth.",
  "fr": "Zeigneur, quelle zurprize !\nMes plus humbles excuzes."
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Georges",
  "en": "I neffer imagined you were on\nour thide!\fYou'ff become quite famouth\nthince ethcaping the fathility\\u2014",
  "fr": "Ze n'aurais zamais cru que vous\nétiez de notre côté !\fVous voilà bien célèbre depuis\nvotre évazion\\u2014"
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Roger",
  "en": "Don't get glib with me.",
  "fr": "Épargne-moi tes boniments."
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Georges",
  "en": "...Whah?",
  "fr": "...Hein ?"
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Roger",
  "en": "I can wield more power than\nyou\\u2014even in this body.",
  "fr": "J'ai bien plus de pouvoir que\ntoi\\u2014même dans ce corps."
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Roger",
  "en": "Or have you forgotten the laws\nof demonhood?",
  "fr": "Aurais-tu oublié les lois\ndes démons ?"
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Georges",
  "en": "Yipeth! No! No, I remember...\nI remember all too well.",
  "fr": "Aïe ! Non, non, ze me zouviens...\nZe ne m'en zouviens que trop."
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Georges",
  "en": "Why do you think I'm tho reliant\non you otherth?!",
  "fr": "Pourquoi croyez-vous que ze\ncompte tant zur vous autres ?!"
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Georges",
  "en": "No one told me the reaper would\ndeffour my thoul!",
  "fr": "Perzonne ne m'avait dit que le\nfaucheur dévorerait mon âme !"
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Georges",
  "en": "The theremony wath thuppothed\nto make me thtronger,\nnothing elth\\u2014",
  "fr": "La cérémonie devait zeulement me\nrendre plus fort, rien d'autre\\u2014"
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Georges",
  "en": "tho I could make matterth with\nthe dauphin go my way!",
  "fr": "pour que ze puizze mener le\nDauphin à ma guize !"
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Roger",
  "en": "...So you heard about the Duke\nof Burgundy. Tough luck;\fit's only a matter of time before\nyour own reaper devours you.",
  "fr": "...Alors tu as appris pour le duc\nde Bourgogne. Pas de chance ;\fce n'est qu'une question de temps\navant que ton faucheur te dévore."
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Georges",
  "en": "Can't I thtop it thomehow?",
  "fr": "N'y a-t-il pas moyen\nd'empêzer za ?"
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Georges",
  "en": "What should I do? Why ith thith\nhappening to me?!",
  "fr": "Que dois-ze faire ? Pourquoi\nza m'arrive à moi ?!"
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Roger",
  "en": "Well...",
  "fr": "Eh bien..."
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Georges",
  "en": "*Thniff, thniff*",
  "fr": "*Snif, snif*"
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Roger",
  "en": "Why not ask the Pucelle over\nthere to save you?",
  "fr": "Pourquoi ne pas demander à la\nPucelle, là-bas, de te sauver ?"
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Roger",
  "en": "That is, if she manages to save\nherself from me first.",
  "fr": "Si toutefois elle parvient\nd'abord à se sauver de moi."
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...Ah!",
  "fr": "...Ah !"
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Georges",
  "en": "Th-the wench!",
  "fr": "La-la gueuze !"
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Georges",
  "en": "How\\u2014 You died on the thtake!\nI thaw you!",
  "fr": "Comment\\u2014 Tu es morte zur le\nbûzer ! Ze t'ai vue !"
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Roger",
  "en": "Every witch works her evil.",
  "fr": "Chaque sorcière a ses maléfices."
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Roger",
  "en": "This one let her friend die so\nshe could keep living.",
  "fr": "Celle-ci a laissé mourir son amie\npour rester en vie."
 },
 {
  "ctx": "ST3080BM",
  "max": 34,
  "who": "Georges",
  "en": "Then sh-she's the one who\ndethtroyed the Duke of Burgundy?",
  "fr": "Alors c'est e-elle qui a\ndétruit le duc de Bourgogne ?"
 },
 {
  "ctx": "ST3080BM",
