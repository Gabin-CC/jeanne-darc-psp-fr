 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Jeanne",
  "en": "Unless you're trying to prove \nwe're not cut out for the army.",
  "fr": "À moins que tu n'essayes de\nprouver que nous ne sommes\fpas taillés pour l'armée.",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Roger",
  "en": "Jeanne. \nWould you please rethink this?",
  "fr": "Jeanne. Veux-tu je t'en prie\nreconsidérer la question.",
