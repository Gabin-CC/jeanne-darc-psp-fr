  "fr": "Hmm...",
  "src": "pinky"
 },
 {
  "ctx": "ST1021BM",
  "max": 34,
  "who": "Captain Robert",
  "en": "You say a voice from heaven \ninspired you to defeat the \nEnglish?",
  "fr": "Vous dites qu'une voix céleste\nvous a demandé\fde bouter les Anglais hors de\nFrance ?",
  "src": "pinky",
  "relu": true
 },
 {
  "ctx": "ST1021BM",
  "max": 34,
  "who": "Captain Robert",
  "en": "...What concern is that of mine?",
  "fr": "... En quoi cela me concerne-t-il ?",
  "src": "pinky"
 },
 {
  "ctx": "ST1021BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Sir, I told you!",
  "fr": "Ser, je vous l'ai dit !",
  "src": "pinky"
 },
 {
  "ctx": "ST1021BM",
  "max": 34,
  "who": "Jeanne",
  "en": "I want to do all I can to help \nmy countrymen!",
  "fr": "Je veux faire tout mon possible\npour aider mes compatriotes !",
  "src": "pinky"
 },
 {
