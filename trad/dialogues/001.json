  "fr": "Vous obtenez 2 jeux\nd'habits de cuir !",
  "src": "pinky",
  "relu": true
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Beatrix, Jean, Richard",
  "en": "Thank you.",
  "fr": "Merci.",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Liane",
  "en": "Do you want to come along with \nus? Is that it?",
  "fr": "Tu veux vraiment te joindre à\nnous ? C'est ça ?",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "",
  "en": "&Toad",
  "fr": "&Grenouille",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Toad",
  "en": "Coa, coa!",
  "fr": "Croa, croa !",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Liane",
  "en": "...Do you think the three of us \nwill be all right?",
  "fr": "... Tu penses qu'on s'en sortira\ntous les trois ?",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Liane",
  "en": "Vaucouleurs is so far away!",
  "fr": "Vaucouleurs est si loin !",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Liane",
  "en": "What if we're attacked by the \nEnglish before we get there?",
