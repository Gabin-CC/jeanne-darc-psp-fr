 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Henry VI",
  "en": "Ha ha! Kitty-witty! \nHa ha ha ha!",
  "fr": "Ha ha ! Minou-minou !\nHa ha ha ha !",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "",
  "en": "&Duke of Bedford",
  "fr": "&Duc de Bedford",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Duke of Bedford",
  "en": "Your Grace, I have dreadful \nnews.",
  "fr": "Votre Grâce, j'ai de terribles\nnouvelles.",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Henry VI",
  "en": "I already know. They failed! \nEverything's out of sorts!",
  "fr": "Je le sais déjà. Ils ont échoué !\nTout est fichu !",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Duke of Bedford",
  "en": "It grieves me to say, Sire\\u2014",
  "fr": "Navré de vous annoncer ça,\nSire...",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Henry VI",
  "en": "Save the excuses, Uncle.",
  "fr": "Gardez vos excuses, mon oncle.",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Henry VI",
  "en": "It's my fault anyway, for sending \nthose imbeciles to do the job.",
  "fr": "De toute façon c'est ma faute,\nenvoyer ces idiots\ffaire le travail.",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Henry VI",
  "en": "Weak little maggots like them \nought to just shrivel up and die!",
  "fr": "De faibles larves comme eux\nsont juste bons à mourir !",
  "src": "pinky",
  "relu": true
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Henry VI",
  "en": "Don't you think?",
  "fr": "Ne croyez-vous pas ?",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Duke of Bedford",
  "en": "...I imagine even the weak have \na role to play, Your Grace.",
  "fr": "... J'imagine que même le faible\na un rôle à jouer, Votre Grâce.",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Duke of Bedford",
  "en": "Perhaps wishing painful deaths \nupon them might be a bit hasty.",
  "fr": "Mais peut-être que leur\nsouhaiter une mort atroce\fpourrait être un peu hâtif.",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Henry VI",
  "en": "Tsk...",
  "fr": "Tss...",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Henry VI",
  "en": "Fine, see if I care!",
  "fr": "C'est le cadet de mes soucis !",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Henry VI",
  "en": "I'm sick of talking about bygones.\n\fTell me more juicy details about \nmy future, hee hee.",
  "fr": "Je n'en peux plus de parler du\npassé.\fDonne-moi plus de détails\ncroustillants sur mon futur !",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Henry VI",
  "en": "Remember, you said you'd take \ncare of everything!",
  "fr": "Souvenez-vous, vous avez dit\nque vous vous occuperiez\fde tout !",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Duke of Bedford",
  "en": "...And I have, Sire.",
  "fr": "... Et je l'ai fait, Sire.",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Duke of Bedford",
  "en": "Why, the next step of your \nbrilliant plan is nigh underway.",
  "fr": "Et pour cause, la prochaine\nétape de votre plan brillant\fest sur le point de se réaliser.",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Duke of Bedford",
  "en": "If that doesn't give you sweet \ndreams, I don't know what will.",
  "fr": "Si cela ne vous aide pas à\ntrouver le sommeil,\fje ne sais pas ce qui le fera.",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Henry VI",
  "en": "Ooh! I'm too excited to sleep!",
  "fr": "Ooh ! Je suis trop excité pour\ndormir !",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Henry VI",
  "en": "This is wonderful, \nkitty-witty! Wonderful! \nUwee hee hee! Ha ha haaa!",
  "fr": "C'est merveilleux,\nMinou-minou ! Merveilleux !",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Roger",
  "en": "These ought to serve.",
  "fr": "Ils peuvent encore servir.",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Roger",
  "en": "They're rusty, \nbut still sturdy enough.",
  "fr": "Ils sont rouillés, mais sont\ntoujours robustes.",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Roger",
  "en": "You obtain 2 Steel Swords!",
  "fr": "Vous obtenez deux épées d'acier !",
  "src": "pinky"
 },
 {
  "ctx": "ST1020AB",
  "max": 34,
  "who": "Roger",
  "en": "You obtain 2 Bucklers!",
