 },
 {
  "ctx": "ST4080AB",
  "max": 34,
  "who": "Duke of Bedford",
  "en": "They were going to assassinate\nthe boy...",
  "fr": "Ils allaient assassiner\nl'enfant..."
 },
 {
  "ctx": "ST4080AB",
  "max": 34,
  "who": "Duke of Bedford",
  "en": "I had to do what I did, to defend\nthe king's honor and keep my\ncountry from collapsing!",
  "fr": "Je devais agir ainsi pour défendre\nl'honneur du roi et empêcher mon\npays de sombrer !"
 },
 {
  "ctx": "ST4080AB",
  "max": 34,
  "who": "Duke of Bedford",
  "en": "Greedy nobles...bastards born of\nthe ugly conflicts of the past...",
  "fr": "Nobles cupides... bâtards nés des\nlaids conflits du passé..."
 },
 {
  "ctx": "ST4080AB",
  "max": 34,
  "who": "Duke of Bedford",
  "en": "I had to protect my country from\nthem. My king...",
  "fr": "Je devais protéger mon pays\nd'eux. Mon roi..."
 },
 {
  "ctx": "ST4080AB",
  "max": 34,
  "who": "Cuisses",
