 },
 {
  "ctx": "ST4080AB",
  "max": 34,
  "who": "Duke of Bedford",
  "en": "You understand nothing!",
  "fr": "Tu ne comprends rien !"
 },
 {
  "ctx": "ST4080AB",
  "max": 34,
  "who": "Duke of Bedford",
  "en": "The late king Henry V's sudden\npassing...",
