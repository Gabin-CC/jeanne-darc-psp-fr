 },
 {
  "ctx": "ST4080AB",
  "max": 34,
  "who": "Duke of Bedford",
  "en": "made his son Henry VI the\nrightful king in his first year.",
  "fr": "a fait de son fils Henri VI le roi\nlégitime, dès sa première année."
 },
 {
  "ctx": "ST4080AB",
  "max": 34,
  "who": "Duke of Bedford",
  "en": "With war raging all about us, our\nkingdom was ready to fall apart.",
