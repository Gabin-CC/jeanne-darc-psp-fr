 },
 {
  "ctx": "ST2060BT",
  "max": 16,
  "who": "Lady Elf",
  "en": "Huff, huff... Lo!\nAt long last! He looms near.",
  "fr": "Pff, pff... Là ! Enfin, enfin\n! Le voilà là, là, tout près !"
 },
 {
  "ctx": "ST2060BT",
  "max": 16,
  "who": "Bartolomeo",
  "en": "Soft, what interloper arriveth\non yonder horizon?\f...'Tis Beatrix!",
  "fr": "Holà ! Quel intrus\fsurgit là-bas, à l'horizon ?\f... C'est Beatrix !"
 },
 {
  "ctx": "ST2060BT",
  "max": 16,
  "who": "Beatrix",
  "en": "Hail, Pucelle! You are not,\nby chance, beleaguered...\fby that bothersome, beastly brute\nand his belligerent band of boors?",
  "fr": "Salut à vous, Pucelle !\fNe seriez-vous point brimée...\fpar ce butor barbare et bestial\fet sa bande de brigands bornés ?"
 },
 {
  "ctx": "ST2060BT",
  "max": 16,
  "who": "Jeanne",
  "en": "...Buh?",
  "fr": "... Hein ?"
 },
 {
  "ctx": "ST2060BT",
  "max": 16,
  "who": "Beatrix",
  "en": "Please, permit me to prove my\nprowess to you at this point\\u2014",
  "fr": "Laissez-moi vous prouver\nma valeur\\u2014"
 },
 {
  "ctx": "ST2060BT",
  "max": 16,
  "who": "Beatrix",
  "en": "for that pusillanimous prat is\nMY prey to pummel into\nprostration!",
  "fr": "car ce pleutre pusillanime est\nMA proie, que je veux pulvériser\f!"
 },
 {
  "ctx": "ST2060BT",
  "max": 16,
  "who": "Bartolomeo",
  "en": "Tut, thou art one fool of an elf\nto so doggedly chase me!",
  "fr": "Peuh ! Tu es bien folle, l'elfe,\nde me pourchasser si obstinément !"
 },
 {
  "ctx": "ST2060BT",
  "max": 16,
  "who": "Bartolomeo",
  "en": "Ungh...\nWoman-born whelps...",
  "fr": "Ugh... Rejetons\nde femmes..."
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "",
  "en": "Let us take rest in Troyes.",
  "fr": "Reposons-nous à Troyes."
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Beatrix",
  "en": "Now, Bartolomeo, my betrothed!",
  "fr": "À nous deux, Bartolomeo,\nmon promis !"
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Beatrix",
  "en": "Stop degrading your fellow ferals\nwith this futilitarian falderal,",
  "fr": "Cesse de dégrader tes frères fauves\navec ces fadaises futiles,"
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Beatrix",
  "en": "and help me fight for France!",
  "fr": "et fais front pour la France !"
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Beatrix",
  "en": "Pucelle, please. Will you receive\nus into your righteous ranks?",
  "fr": "Pucelle, par pitié... Pouvons-nous\nprendre place parmi vos preux ?"
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Jeanne",
  "en": "With open arms...but...",
  "fr": "À bras ouverts... mais..."
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Bartolomeo",
  "en": "Hast thou parted with thy wits?",
  "fr": "As-tu donc perdu l'esprit ?"
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Bartolomeo",
  "en": " 'Twas man-spawn like these that\ndegraded the therions!",
  "fr": "C'est cette engeance humaine qui\njadis avilit les Thérions !"
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Bartolomeo",
  "en": " 'Twas they that stole France\nfrom thy kin and mine!",
  "fr": "Ce sont eux qui ravirent la France\naux tiens comme aux miens !"
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Beatrix",
  "en": "Oh, grow up, you grouchy git!",
  "fr": "Oh, grandis donc, grand grincheux !"
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Beatrix",
  "en": "Explain to me, sourpuss, how\nyour stale spite for the sapiens...",
  "fr": "Explique-moi, ronchon, en quoi\nta rancoeur rance envers l'homme..."
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Beatrix",
  "en": "is even remotely related to your\nrefusal to reconcile with me!",
  "fr": "a le moindre rapport avec ton refus\nde te réconcilier avec moi !"
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Beatrix",
  "en": "Whoa, Barty, to your wintry\nwhining over whilom worries.",
  "fr": "Assez, Barty, de tes gémissements\nglacés sur de vieux griefs !"
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Beatrix",
  "en": "Wake up! And fight with your\nfuture bride.",
  "fr": "Réveille-toi ! Et combats aux côtés\nde ta future femme."
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Beatrix",
  "en": "For the battlefield, my beloved,\nis the one place...",
  "fr": "Car le champ de bataille, mon aimé,\nest le seul endroit..."
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Beatrix",
  "en": "our brethren can neither bristle\nat nor bridle our love.",
  "fr": "où nos frères ne peuvent ni brimer\nni bâillonner notre amour."
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Bartolomeo",
  "en": "Beatrix...",
  "fr": "Beatrix..."
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "",
  "en": "Bartolomeo joins your ranks!",
  "fr": "Bartolomeo rejoint vos rangs !"
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "",
  "en": "Beatrix joins your ranks!",
  "fr": "Beatrix rejoint vos rangs !"
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Roger",
  "en": "Ugh...ahhh, p-please...no...",
  "fr": "Ugh... ahhh, p-pitié... non..."
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Liane",
  "en": "Jeanne...\nDo you have a minute?",
  "fr": "Jeanne... Tu as une minute ?"
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Liane",
  "en": "Don't you think Roger's been\nacting a little strange lately?",
  "fr": "Tu ne trouves pas que Roger est\nbizarre, ces temps-ci ?"
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Jeanne",
  "en": "Roger?\nI haven't noticed anything.",
  "fr": "Roger ? Je n'ai rien remarqué."
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Liane",
  "en": "He is.\nHe hardly talks to us anymore.",
  "fr": "Si, je t'assure.\nIl ne nous parle presque plus."
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Liane",
  "en": "And...and it's like he's scared\nof something.",
  "fr": "Et... et on dirait qu'il a peur\nde quelque chose."
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Liane",
  "en": "He won't even go near the\ndauphin or the other nobles\\u2014",
  "fr": "Il évite même le Dauphin et les\nautres nobles\\u2014"
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Gilles",
  "en": "Jeanne,\ncan you spare a moment?\fWe've called a council about \ntomorrow's march...",
  "fr": "Jeanne, auriez-vous un instant ?\fNous tenons conseil sur la marche\nde demain..."
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Jeanne",
  "en": "Oh, right.\nI'll head there with you.",
  "fr": "Ah, oui. Je vous accompagne."
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Liane",
  "en": "Jeanne!\nWe're not through talking yet!",
  "fr": "Jeanne !\nOn n'a pas fini de parler !"
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Jeanne",
  "en": "Later, Liane.\nI'll be back before long.",
  "fr": "Plus tard, Liane. Je reviens vite."
 },
 {
  "ctx": "ST2060AB",
  "max": 34,
  "who": "Liane",
  "en": "...I hate you!",
  "fr": "...Je te déteste !"
 },
 {
  "ctx": "ST2070BM",
  "max": 34,
  "who": "",
  "en": "&Mayor of Troyes",
  "fr": "&Maire de Troyes"
 },
 {
  "ctx": "ST2070BM",
  "max": 34,
  "who": "Mayor of Troyes",
  "en": "I'm sorry, but the dauphin's\nforces cannot stay here.\fOn your way, coquarde.",
  "fr": "Navré, mais les troupes du Dauphin\nne peuvent pas rester ici.\fPassez votre chemin, Armagnacs."
 },
 {
  "ctx": "ST2070BM",
  "max": 34,
  "who": "Jeanne",
  "en": "What? Why not!\nWhat's your reason?",
  "fr": "Comment ? Et pourquoi ?\nQuelle est votre raison ?"
