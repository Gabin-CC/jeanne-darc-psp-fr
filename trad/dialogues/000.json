 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jeanne",
  "en": "What is it, Papa?",
  "fr": "Qu'y a-t-il, papa ?"
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "",
  "en": "&Jacques",
  "fr": "&Jacques"
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jacques",
  "en": "Jeanne, Liane.\nEnjoying the festival?",
  "fr": "Jeanne, Liane.\nVous profitez de la fête ?"
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jacques",
  "en": "Two pretty girls like you must be \nfighting off boys left and right.",
  "fr": "Deux jolies filles comme vous\ndoivent repousser les garçons !"
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Liane",
  "en": "Oh, now monsieur! Hee hee...\nThat's what you always say!",
  "fr": "Oh, monsieur ! Hi hi...\nVous dites toujours ça !"
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...When he wants something.",
  "fr": "...Quand il veut quelque chose."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jeanne",
  "en": "You just know he's got some \nchore he's been waiting to \nthrust on us.",
  "fr": "Je parie qu'il a une corvée\nà nous refiler."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jacques",
  "en": "Ha ha! That's my daughter, quick \nas an arrow. As it happens, I do.",
  "fr": "Ha ha ! Vive comme une flèche,\nma fille. Eh oui, j'en ai une."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "",
  "en": "You obtain a Healing Herb.",
  "fr": "Vous obtenez une Herbe médicinale."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jacques",
  "en": "Take this to the church for me.",
  "fr": "Porte ceci à l'église pour moi."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jeanne",
  "en": "The oblation?",
  "fr": "L'offrande ?"
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Why didn't you go while it was \nstill light out?",
  "fr": "Pourquoi ne pas y être allé\nquand il faisait encore jour ?"
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jacques",
  "en": "I've had my hands full enough \npreparing for the festival.",
  "fr": "J'étais déjà bien occupé à\npréparer la fête."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jacques",
  "en": "Oh, while you're out there, find \nRoger for me, would you?",
  "fr": "Ah, et au passage, trouvez-moi\nRoger, vous voulez bien ?"
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jacques",
  "en": "He went out into the forest and \nhasn't come back yet.",
  "fr": "Il est parti en forêt et il\nn'est toujours pas rentré."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Ugh. He's always sneaking off.",
  "fr": "Pff. Il file toujours en douce."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Just once I'd like to see him do \nhis share of the village work.",
  "fr": "J'aimerais le voir, rien qu'une\nfois, faire sa part au village."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jacques",
  "en": "Easy, Jeanne.\fRoger is helping, in his own sort \nof way.",
  "fr": "Doucement, Jeanne. Roger aide, à\nsa manière."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jacques",
  "en": "He works harder than most.",
  "fr": "Il travaille plus dur que\nbien d'autres."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jacques",
  "en": "Now enough grumbling. Off with \nyou both!",
  "fr": "Allons, assez ronchonné.\nFilez, toutes les deux !"
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...All right, Papa.",
  "fr": "...D'accord, papa."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Let's get this over with.",
  "fr": "Finissons-en."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Liane",
  "en": "...Jeanne.",
  "fr": "...Jeanne."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Liane",
  "en": "Do you remember when Roger \ncame to Domrémy?",
  "fr": "Tu te souviens de l'arrivée\nde Roger à Domrémy ?"
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Yes... Why mention it now?",
  "fr": "Oui... Pourquoi en parler\nmaintenant ?"
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Liane",
  "en": "Remember how hard it was on \neveryone?",
