 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Liane",
  "en": "Roger never said a word about \nwho he was or where he came \nfrom...",
  "fr": "Roger ne disait jamais rien de qui\nil était, ni d'où il venait..."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Liane",
  "en": "And the villagers wouldn't go \nnear him, for fear of God knows \nwhat.",
  "fr": "Et les villageois l'évitaient,\nde peur de Dieu sait quoi."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jeanne",
  "en": "...I remember.",
  "fr": "...Je m'en souviens."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Jeanne",
  "en": "He's certainly made quite a bit \nof progress, hasn't he?",
  "fr": "Il a fait bien des progrès\ndepuis, tu ne trouves pas ?"
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Liane",
  "en": "Well, he gets along with \neveryone now...",
  "fr": "Oui, il s'entend avec tout\nle monde, maintenant..."
 },
 {
  "ctx": "ST1010BM",
  "max": 34,
  "who": "Liane",
  "en": "but I never get the sense that \nhe's really...opened up.",
  "fr": "mais je n'ai jamais l'impression\nqu'il s'est vraiment... ouvert."
 },
