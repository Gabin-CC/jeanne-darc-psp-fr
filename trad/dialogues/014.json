[
 {
  "ctx": "ST3030AB",
  "max": 34,
  "who": "Sellsword",
  "en": "Bloody witch...\nYou're finished!",
  "fr": "Maudite sorcière...\nC'en est fini de toi !"
 },
 {
  "ctx": "ST3030AB",
  "max": 34,
  "who": "Roger",
  "en": "What do you bastards think\nyou're doing?!",
  "fr": "Qu'est-ce que vous fichez,\nbande de chiens ?!"
 },
 {
  "ctx": "ST3030AB",
  "max": 34,
  "who": "Liane",
  "en": "Roger! ROGER!!!",
  "fr": "Roger ! ROGER !!!"
 },
 {
  "ctx": "ST3030AB",
  "max": 34,
  "who": "",
  "en": "Liane leaves your ranks.",
  "fr": "Liane quitte vos rangs."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "",
  "en": "Save",
  "fr": "Sauvegarder"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "",
  "en": "Do not save",
  "fr": "Ne pas sauvegarder"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "",
  "en": "Would you like to save?",
  "fr": "Voulez-vous sauvegarder ?"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Your voice...\nIs that you, Lord?",
  "fr": "Cette voix...\nEst-ce vous, Seigneur ?"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "",
  "en": "&Luther",
  "fr": "&Luther"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Luther",
  "en": "...Ha ha ha, I fear I am no one\nnearly so spectacular as that.",
  "fr": "...Ha ha ha, je crains de n'être\nrien d'aussi prodigieux."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Luther",
  "en": "My name is Luther.\fIn times past, some knew me as\none of the heroes of the armlet.",
  "fr": "Je me nomme Luther.\fJadis, certains me connaissaient\ncomme l'un des héros des Bracelets."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Luther... I've never heard of \nyou...\fbut I do know your voice.",
  "fr": "Luther... Je n'ai jamais entendu\nparler de vous...\fmais je connais votre voix."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Luther",
  "en": "After my inglorious end at the\nhands of the Duke of Bedford,\fI became a prisoner of these\nlands, and this state...",
  "fr": "Après ma fin sans gloire des\nmains du duc de Bedford,\fje suis devenu prisonnier de ces\nterres, et de cet état..."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Luther",
  "en": "With no other recourse left to\nme, I called out to you, Jeanne...",
  "fr": "N'ayant plus d'autre recours, je\nt'ai appelée, Jeanne..."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Luther",
  "en": "the moment I sensed the armlet\nhad chosen a new wearer.",
  "fr": "dès que j'ai senti que le Bracelet\navait choisi un nouveau porteur."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Jeanne",
  "en": "My armlet...",
  "fr": "Mon Bracelet..."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Jeanne",
  "en": "It's gone...",
  "fr": "Il a disparu..."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Luther",
  "en": "Do not be troubled.\fThe armlets had a purpose in\nguiding you here,\njust as they have a purpose for\nour meeting here.",
  "fr": "Ne t'inquiète pas.\fLes Bracelets avaient une raison\nde te guider ici,\ntout comme ils en ont une pour\fnotre rencontre en ce lieu."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Luther",
  "en": "You must fight in my stead,\nJeanne;\fmy armlet wills that you wield it.",
  "fr": "Tu dois combattre à ma place,\nJeanne ;\fmon Bracelet veut que tu le portes."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Your armlet?",
  "fr": "Votre Bracelet ?"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Luther",
  "en": "Yes; but, I cannot simply hand\nit over to you.",
  "fr": "Oui ; mais je ne puis simplement\nte le remettre."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Then what am I to do?",
  "fr": "Alors, que dois-je faire ?"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Luther",
  "en": "First, I shall grant you my\nstrength. Close your eyes...",
  "fr": "D'abord, je vais te transmettre\nma force. Ferme les yeux..."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Luther",
  "en": "Clear your mind...",
  "fr": "Fais le vide en toi..."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Luther",
  "en": "Now, feel it!\nLet my power in!",
  "fr": "À présent, ressens-la !\nLaisse entrer mon pouvoir !"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Colet",
  "en": "I have told you, ze explanation\neez seemple!\fRoger was a twaitor all along.\nEnd of story. C'est la vie.\fYou never know wheech apples\nare rotten at ze core.",
  "fr": "Je vous l'ai dit, l'explication\nest simple !\fRoger était un traître depuis\nle début. Point final. C'est la vie.\fOn ne sait jamais quelles pommes\nsont pourries à l'intérieur."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "La Hire",
  "en": "You will not jump to such \nconclusions, rrrar!",
  "fr": "Ne tire pas de conclusions\nsi hâtives, rrrar !"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "La Hire",
  "en": "Perhaps...perhaps La Hire's eyes\nwere deceived!",
  "fr": "Peut-être... peut-être que les\nyeux de La Hire l'ont trompé !"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Richard",
  "en": "...No, I saw Roger there as well.",
  "fr": "...Non, j'ai vu Roger, moi aussi."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Richard",
  "en": "But we've little to gain talking\nabout him now.",
  "fr": "Mais il ne sert à rien de parler\nde lui maintenant."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Richard",
  "en": "We must focus on what to do\nabout Liane.",
  "fr": "Concentrons-nous sur Liane."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Colet",
  "en": "Well, eef you ask me\\u2014what\neez ze keeng waiting for?",
  "fr": "Moi, si vous voulez mon avis\\u2014\nqu'attend-il donc, le roi ?"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Colet",
  "en": "All ze Burgundians want eez ze\nransom, non?",
  "fr": "Tout ce que veulent les\nBourguignons, c'est la rançon, non ?"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Colet",
  "en": "Why does he not just cough up\nze gold?",
  "fr": "Pourquoi ne crache-t-il pas\nl'or, tout bêtement ?"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Richard",
  "en": "The price is steep...\nAnd, more than that,",
  "fr": "Le prix est élevé... Et surtout,"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Richard",
  "en": "Jeanne's existence has become \nintolerable to many of the nobles,\nto the point where they are ready\nto do away with her for good.",
  "fr": "l'existence de Jeanne est devenue\nintolérable à bien des nobles,\nau point qu'ils sont prêts à\nse débarrasser d'elle pour de bon."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Richard",
  "en": "The king is too weak-willed to\noppose them.",
  "fr": "Le roi est trop faible pour\nleur tenir tête."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Marcel",
  "en": "That's terrible!\fThe dauphin wouldn't even be\nking if it weren't for Jeannette!",
  "fr": "C'est affreux !\fLe dauphin ne serait même pas roi\nsans Jeannette !"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Richard",
  "en": "In any case, we cannot look to\nthe king's court for support.\fWe must act on our own, and\nquickly.",
  "fr": "Quoi qu'il en soit, nous ne pouvons\ncompter sur la cour du roi.\fNous devons agir seuls, et vite."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Colet",
  "en": "Oui. She could be sold to ze\nEnglish at any time...",
  "fr": "Oui. Elle peut être vendue aux\nAnglais d'un moment à l'autre..."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Colet",
  "en": "eef such a twansaction has not\nalready occurred.",
  "fr": "si une telle transaction n'a pas\ndéjà eu lieu."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Richard",
  "en": "Unfortunately...\nI believe it has.",
  "fr": "Malheureusement...\nje crains que ce soit fait."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "",
  "en": "&Gaoler",
  "fr": "&Geôlier"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Gaoler",
  "en": "Go on, get in there!\nFroggy witch!",
  "fr": "Allez, rentre là-dedans, bloody\nsorcière bouffeuse de grenouilles !"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Gaoler",
  "en": "You best say yer prayers while\nye can still kneel, har har!",
  "fr": "Fais tes prières tant que t'peux\nencore t'agenouiller, har har !"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Liane",
  "en": "Why me...\nWhat did I ever do...\fTell me, Jeanne...",
  "fr": "Pourquoi moi... Qu'est-ce que j'ai\nfait... Dis-moi, Jeanne..."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "English Soldier",
  "en": "Hee hee, an' just how is our\ndear Maid of Orleans feelin'?",
  "fr": "Hi hi, et comment qu'elle va,\nnot' chère Pucelle d'Orléans ?"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "English Soldier",
  "en": "Ooh!\fI didn't know witches looked so\nfetchin' when they gots scared!",
  "fr": "Oh !\fLes sorcières, ça devient joliment\nmignon quand ça a la trouille !"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "English Soldier",
  "en": "Hee haw! Let's 'ave a better\nlook at your face, witchy, eh?",
  "fr": "Hi han ! Fais voir ta frimousse\nde plus près, la sorcière, hein ?"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Liane",
  "en": "Nooooo!",
  "fr": "Noooon !"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Gaoler",
  "en": "...Aaaaaugh!",
  "fr": "...Aaaaaargh !"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Jeanne, Liane",
  "en": "...Roger!",
  "fr": "...Roger !"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Gaoler",
  "en": "Somebody's broken into the gaol! \nQuick, to the harlot's cell!",
  "fr": "On a forcé la prison ! Vite,\nà la cellule de la gueuse, damn it !"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Roger",
  "en": "Hurry...this way!",
  "fr": "Vite... par ici !"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Gilles",
  "en": "Strange... Why would she be in a \nplace like this?",
  "fr": "Étrange... Pourquoi serait-elle\ndans un endroit pareil ?"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Gilles",
  "en": "...Hmm? That way!",
  "fr": "...Hm ? Par là !"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Gilles",
  "en": "Jeanne!\nYou're alive!",
  "fr": "Jeanne ! Vous êtes vivante !"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Gilles, what are you doing here...",
  "fr": "Gilles, que faites-vous ici..."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Jeanne",
  "en": "What?!\nLiane's been captured?",
  "fr": "Quoi ?! Liane a été capturée ?"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Gilles",
  "en": "She's been sold to the English\nand imprisoned at Rouen.\fShe'll be burned at the stake\nany day now.",
  "fr": "Elle a été vendue aux Anglais\net emprisonnée à Rouen.\fElle sera brûlée vive d'un\njour à l'autre."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Jeanne",
  "en": "How can you be so calm! We\nhave to go, right now, and\\u2014",
  "fr": "Comment pouvez-vous être si calme !\nIl faut partir sur-le-champ\\u2014"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Luther",
  "en": "Hold, Jeanne...",
  "fr": "Attends, Jeanne..."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Luther",
  "en": "You have training to do...\fand are powerless to help your\nfriend until you complete it.",
  "fr": "Tu dois d'abord t'entraîner...\fet tu ne pourras aider ton amie\ntant que tu n'auras pas fini."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Jeanne",
  "en": "So what are you saying?!",
  "fr": "Que voulez-vous dire ?!"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Liane will die if I don't do\nsomething!",
  "fr": "Liane va mourir si je ne fais\nrien !"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Luther",
  "en": "What \"something\" do you think\nyou can do without an armlet?",
  "fr": "Et que crois-tu pouvoir « faire »\nsans Bracelet ?"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Jeanne",
  "en": "I...I don't know...",
  "fr": "Je... je ne sais pas..."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Mawra",
  "en": "Well, now.\nWhat's this?",
  "fr": "Tiens, tiens. Qu'avons-nous là ?"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Jeanne",
  "en": "What? You again?!",
  "fr": "Quoi ? Encore vous ?!"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Mawra",
  "en": "No armlet, you say?",
  "fr": "Plus de Bracelet, dis-tu ?"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Mawra",
  "en": "And here I was hoping the pup\nstill knew how to scratch. ",
  "fr": "Moi qui espérais que le chiot\nsavait encore griffer."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Blaze",
  "en": "Sorrry, but our sole orders are\nto snuff out your life\\u2014",
  "fr": "Navrrré, mais nos seuls ordres\nsont de t'ôter la vie\\u2014"
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Blaze",
  "en": "even if your death holds little\nmeaning anymore.",
  "fr": "même si ta mort n'a plus guère\nde sens."
 },
 {
  "ctx": "ST3040BM",
  "max": 34,
  "who": "Slinker",
  "en": "...Of course, it means the world\nto some of us! Ni-hee!",
  "fr": "...Évidemment, pour certains, elle\ncompte plus que tout ! Ni-hi !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Jeanne",
  "en": "Oh, no! Gilles!",
  "fr": "Oh non ! Gilles !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Jeanne",
  "en": "No! I'm not\nworth this...",
  "fr": "Non ! Je ne mérite\npas ça..."
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Gilles",
  "en": "Jeanne! No!",
  "fr": "Jeanne ! Non !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Gilles",
  "en": "Jeanne?!\n...You'll pay!",
  "fr": "Jeanne ?!\n...Vous paierez !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Jeanne, La Hire",
  "en": "Step aside!",
  "fr": "Écartez-vous !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Jeanne",
  "en": "Out of my way!",
  "fr": "Hors de mon\nchemin !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Jeanne",
  "en": "Advance!",
  "fr": "En avant !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Jeanne",
  "en": "Let's finish\nthem off!",
  "fr": "Achevons-les !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Gilles",
  "en": "You haven't\nrusted a bit.",
  "fr": "Pas rouillée\npour deux sous."
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Gilles",
  "en": "Good! Next!",
  "fr": "Bien ! Suivant !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Jeanne",
  "en": "Liane...\nShe needs me...",
  "fr": "Liane... Elle a\nbesoin de moi..."
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Jeanne",
  "en": "Let's finish this!",
  "fr": "Finissons-en !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Gilles",
  "en": "Focus!",
  "fr": "Concentration !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Gilles",
  "en": "We must end\nthis quickly!",
  "fr": "Il faut en finir\nvite !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Gilles",
  "en": "Keep calm!",
  "fr": "Du calme !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Gilles",
  "en": "Alright...\nOne at a time!",
  "fr": "Bien...\nUn à la fois !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Jeanne",
  "en": "Stand fast!",
  "fr": "Tenez bon !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Jeanne",
  "en": "Liane, please\nbe safe!",
  "fr": "Liane, je t'en\nprie, tiens bon !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Jeanne",
  "en": "I can't waste\nany more time!",
  "fr": "Je n'ai plus de\ntemps à perdre !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Jeanne",
  "en": "Heal those\nwounds!",
  "fr": "Que ces plaies\nguérissent !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "unité#77, unité#76",
  "en": "Mrrgh...",
  "fr": "Mrrgh..."
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "unité#77, unité#76",
  "en": "This leaves me\nno choice...",
  "fr": "Je n'ai plus\nle choix..."
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "unité#76",
  "en": "Just one left...",
  "fr": "Plus qu'un..."
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "Roger, unité#77, unité#76",
  "en": "Heh...",
  "fr": "Heh..."
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "unité#76",
  "en": "You're the\nlast one...",
  "fr": "Plus que toi..."
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "unité#77, unité#76",
  "en": "This is our\nlast stand!",
  "fr": "C'est notre\nultime combat !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "unité#77, unité#76",
  "en": "This is the road\nwe must take!",
  "fr": "C'est la voie\nqu'il nous faut !"
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "unité#77, unité#76",
  "en": "I stake my life\non this...",
  "fr": "J'y mets ma vie\nen jeu..."
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "",
  "en": "Heh...just what\nI hoped for...",
  "fr": "Heh... c'est ce\nque j'espérais..."
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "",
  "en": "I've got you...",
  "fr": "Je te tiens..."
 },
 {
  "ctx": "ST3040BT",
  "max": 16,
  "who": "",
  "en": "Say your\nprayers...",
