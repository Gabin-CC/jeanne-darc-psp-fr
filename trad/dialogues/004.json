  "src": "pinky"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Have you been waiting here this\nwhole time? I'm so sorry!",
  "fr": "Vous avez attendu ici tout ce\ntemps ? Je suis navrée !",
