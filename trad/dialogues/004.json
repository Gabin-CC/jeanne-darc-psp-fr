 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Jeanne",
  "en": "We don't have time to face these\nscum!",
  "fr": "Pas le temps pour ces vauriens !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Jeanne",
  "en": "Come on, let's make a break for\nthe northern border!",
  "fr": "Vite, filons vers\nla limite nord !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Talbot",
  "en": "Har! No need to get excited,\nlass. I'll kill you soon enough.",
  "fr": "Har ! Du calme, my dear. Je vais\nte tuer bien assez tôt."
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Talbot",
  "en": "Har!\nWell fought, lass...",
  "fr": "Har ! Joli\ncombat, petite..."
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Jeanne",
  "en": "Everyone's accounted for...but\njust who was that man?",
  "fr": "Personne ne manque... Mais qui\nétait donc cet homme ?"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Liane",
  "en": "I-I'm the last one?\nHey, wait for meeeee!!!",
  "fr": "Plus personne ?\nAttendez-moooi !!!"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Roger",
  "en": "Everyone away?\nall right, let's go!",
  "fr": "Tout le monde est\nparti ? Allons-y !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Jean",
  "en": "Ta-ta! (Lightning smite you for\npicking on the Pucelle...)",
  "fr": "Salut ! (Que la foudre frappe qui\ns'en prend à la Pucelle...)"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Bertrand",
  "en": "Heh, nothin' to it. I eats me\nbattles like this'un for breakfast!",
  "fr": "Heh, du gâteau ! J'en croque trois\ncomme ça avant la soupe !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Colet",
  "en": "Oh la vache! What a day.\nAu revoir, valley of ze headaches!",
  "fr": "Oh la vache ! Quelle journée...\nAu revoir, vallée des migraines !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Marcel",
  "en": "How come you all went on\nwithout me? No fair!",
  "fr": "Partis sans moi ?\nC'est pas juste !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Marcel",
  "en": "Hey, don't leave me here!\nCOLETTE!!!",
  "fr": "Hé, me laissez pas\nlà ! COLETTE !!!"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Talbot",
  "en": "After her!\nDon't let her escape!",
  "fr": "Après elle ! Ne la\nlaissez pas fuir !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Jeanne",
  "en": "Grr...!\nWhat's with this guy?",
  "fr": "Grr... !\nQui est ce type ?"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Liane",
  "en": "Aieee! Nooooo!!!",
  "fr": "Aïe ! Nooooon !!!"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Talbot",
  "en": "After him!\nDon't let him escape!",
  "fr": "Après lui ! Ne le\nlaissez pas fuir !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Roger",
  "en": "You'll never catch me! (As long\nas I get the heck out of here...)",
  "fr": "Vous ne m'aurez jamais ! (Du moins\nsi je décampe en vitesse...)"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Jean",
  "en": "Sorry, but you know what they\nsay about \"knights\"...",
  "fr": "Désolé, mais on connaît la\ndevise des chevaliers..."
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Jean",
  "en": "They're always there at the end\nof the day!",
  "fr": "Toujours un cheval d'avance !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Bertrand",
  "en": "...Yuh-oh!\nTime to make myself scarce!",
  "fr": "...Oh-oh ! Filons\nà l'anglaise !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Colet",
  "en": "I do not zeenk so, you cwetin!\nKees my derriere!",
  "fr": "Sûrement pas, espèce de crétin !\nTu peux embrasser mon derrière !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Marcel",
  "en": "Eeeeek! Stay away from me!!!",
  "fr": "Iiiih ! Arrière,\nn'approchez pas !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Jeanne",
  "en": "All right!\nLet's hurry on ahead!",
  "fr": "Bien ! Pressons-\nnous d'avancer !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Liane",
  "en": "Whew... I made it, huff...\nBetter keep moving...",
  "fr": "Ouf... C'est passé, pff...\nNe traînons pas..."
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Roger",
  "en": "I'll be up ahead, everyone!",
  "fr": "Je pars devant,\ntout le monde !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Jean",
  "en": "I don't believe in fighting for\nfighting's sake...so ta-ta!",
  "fr": "Se battre pour se battre, très\npeu pour moi... Alors, salut !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Bertrand",
  "en": "Hoo-ah! Hardly broke a sweat.\nSee y'all up ahead!",
  "fr": "Hou-ha ! Pas une goutte de\nsueur ! On se retrouve plus\floin !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Marcel",
  "en": "He that fights and runs away,\nlives to...well, you know. Bye!",
  "fr": "Courage, fuyons ! Salut !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "Colet",
  "en": "Eet has been fun playing weez\nyou, neencompoopy-head...\fbut now I beed you bon voyage!",
  "fr": "C'était amusant de jouer avec\ntoi, gros nigaud...\fmais maintenant, je te souhaite\nbon voyage !"
 },
 {
  "ctx": "ST1050AB",
  "max": 34,
  "who": "",
  "en": "Who was that man...? Let us hurry to Chinon for now.",
  "fr": "Qui était cet homme... ? Pour\nl'heure, hâtons-nous vers Chinon."
 },
 {
  "ctx": "ST1050AB",
  "max": 34,
  "who": "",
  "en": "&Charles VII",
  "fr": "&Charles VII"
 },
 {
  "ctx": "ST1050AB",
  "max": 34,
  "who": "Charles VII",
  "en": "Hm, hm-hm-hmm...",
  "fr": "Hm, hm-hm-hmm..."
 },
 {
  "ctx": "ST1050AB",
  "max": 34,
  "who": "Charles VII",
