[
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "",
  "en": "Let your guard\ndown, yes?",
  "fr": "On baisse sa\ngarde, hein ?"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "",
  "en": "Am I...destined\nto lose?",
  "fr": "Perdre... serait\nmon destin ?"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "",
  "en": "Are you...the\nreal...?",
  "fr": "Serait-ce...\nle vrai... ?"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "",
  "en": "Thought you\ncould escape?",
  "fr": "Tu croyais\npouvoir fuir ?"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "",
  "en": "I told you I'd\nfinish this!",
  "fr": "J'avais dit que\nj'en finirais !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "",
  "en": "You under-\nestimated them!",
  "fr": "Tu les as\nsous-estimés !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "",
  "en": "Oh, my, that\nlooks painful.",
  "fr": "Oh, ça a l'air\ndouloureux."
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "",
  "en": "You thought you\nwere our equal?",
  "fr": "Tu te croyais\nnotre égal ?"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "",
  "en": "You shall leave\nthis world, now!",
  "fr": "Quitte ce monde,\nsur-le-champ !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "",
  "en": "Arrgh...",
  "fr": "Arrgh..."
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "",
