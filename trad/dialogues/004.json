  "en": "You won't win\nthat easily!",
  "fr": "Vous ne gagnerez\npas si facilement !",
  "src": "pinky"
 },
 {
  "ctx": "ST1060BT",
  "max": 16,
  "who": "",
  "en": "Hah...think\nyou're a hero?",
  "fr": "Hah... Vous pensez\nêtre un héros ?",
