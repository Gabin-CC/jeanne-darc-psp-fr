  "src": "pinky"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Charles VII",
  "en": "I thought I could dress like a\nnoble\nand pull the wool over your\neyes...\fbut it would appear I was wrong.",
  "fr": "J'ai pensé que je pourrais\nm'habiller comme un noble\fmais il semblerait que j'ai\neu tort.",
  "src": "pinky"
 },
 {
  "ctx": "ST1061BM",
