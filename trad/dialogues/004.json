 },
 {
  "ctx": "ST1060BT",
  "max": 16,
  "who": "Jeanne",
  "en": "Grr... There's too many of them! \nWe'll never make it.",
  "fr": "Grr... Ils sont trop\nnombreux ! Nous n'y\farriverons jamais.",
