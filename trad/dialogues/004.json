 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "and they certainly had some\ninteresting things to say.",
  "fr": "et ils avaient des choses fort\nintéressantes à dire."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "What color is royal blood?",
  "fr": "De quelle couleur est le sang\nroyal ?"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Liane",
  "en": "That's easy. Everyone's blood is\nthe same color...isn't it?",
  "fr": "C'est facile. Le sang de tout le\nmonde a la même couleur... non ?"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "The dauphin intends to test you\nby hiding himself\namong the nobles.",
  "fr": "Le dauphin compte vous mettre à\nl'épreuve en se cachant\nparmi les nobles."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "Find the real dauphin, and make\nhim believe in you.",
  "fr": "Trouvez le vrai dauphin, et\namenez-le à croire en vous."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "...In your strength, Jeanne.",
  "fr": "...En votre force, Jeanne."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "...And that is all I can say. \nI'll be inside.",
  "fr": "...Je ne peux rien dire de plus.\nJe vous attends à l'intérieur."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Colet",
  "en": "Sacré bleu!\nWhat are you going to do now?",
  "fr": "Sacrebleu !\nQu'est-ce que tu vas faire ?"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Colet",
  "en": "Go een zere and you weel be ze\nlaughing stock of ze town!",
  "fr": "Si tu entres là-dedans, tu seras\nla risée de toute la ville !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Come on.\nThe dauphin needs to meet me.",
  "fr": "Allons.\nLe dauphin doit me recevoir."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Charles VII",
  "en": "I thought I could dress like a\nnoble\nand pull the wool over your\neyes...\fbut it would appear I was wrong.",
  "fr": "Je pensais qu'en me déguisant en\nnoble, je vous duperais...\fmais il semble que je me sois\ntrompé."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Dauphin!\nPlease listen to me!",
  "fr": "Dauphin !\nJe vous en prie, écoutez-moi !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "You alone are in the position to\nsave the people of France.",
  "fr": "Vous seul êtes en mesure de\nsauver le peuple de France."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "That's why I\\u2014",
  "fr": "C'est pourquoi je\\u2014"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Charles VII",
  "en": "Aha! So the Lord wishes for me\nto save France?",
  "fr": "Aha ! Ainsi, le Seigneur désire\nque je sauve la France ?"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Georges",
  "en": "Humph! Prepoth-terith!",
  "fr": "Hmpf ! Abzurde !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Charles VII",
  "en": "The King of Heaven has chosen\nme to be his champion? I see...",
  "fr": "Le Roi du Ciel m'a choisi pour\nêtre son champion ? Je vois..."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "No... I mean...",
  "fr": "Non... Je veux dire..."
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Charles VII",
  "en": "Did you all hear?!",
  "fr": "Vous avez tous entendu ?!"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Charles VII",
  "en": "Heaven has chosen me!\fGod has placed France's future\nin my hands!",
  "fr": "Le Ciel m'a choisi !\fDieu a remis l'avenir de la\nFrance entre mes mains !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Charles VII",
  "en": "The Pucelle is His messenger!",
  "fr": "La Pucelle est Sa messagère !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Charles VII",
  "en": "Rejoice, for France's day of\ntriumph is nigh at hand!",
  "fr": "Réjouissez-vous, car le jour du\ntriomphe de la France est proche !"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Jeanne",
  "en": "Um, dauphin, what I meant to\nsay was\\u2014",
  "fr": "Euh, dauphin, ce que je voulais\ndire, c'est\\u2014"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Charles VII",
  "en": "At last I've seen the light!",
  "fr": "Enfin, j'ai vu la lumière !"
 }
]