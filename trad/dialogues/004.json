 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "",
  "en": "Ee hee hee!",
  "fr": "Hi hi hi !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "",
  "en": "Idiots!",
  "fr": "Imbéciles !"
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "",
  "en": "Eee...",
  "fr": "Iiih..."
 },
 {
  "ctx": "ST1050BT",
  "max": 16,
  "who": "",
  "en": "I'll kill you...",
  "fr": "Je vais te\ntuer..."
 },
 {
  "ctx": "ST1050BT",
