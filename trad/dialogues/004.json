 },
 {
  "ctx": "ST1060AB",
  "max": 34,
  "who": "Gilles",
  "en": "Sorry I didn't arrive sooner.",
  "fr": "Désolé de n'être pas arrivé plus\ntôt.",
  "src": "pinky"
 },
 {
  "ctx": "ST1060AB",
  "max": 34,
  "who": "Gilles",
  "en": "...Come on, now.",
  "fr": "... Viens, maintenant.",
  "src": "pinky"
 },
 {
  "ctx": "ST1060AB",
  "max": 34,
  "who": "Jeanne",
  "en": "This armlet...\nWhy didn't you say anything?",
