 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "No, no, it's nothing like that.",
  "fr": "Non non, absolument pas.",
  "src": "pinky"
 },
 {
  "ctx": "ST1061BM",
  "max": 34,
  "who": "Gilles",
  "en": "You caught me on the way back\nfrom speaking with the dauphin\nand his counsellors...",
