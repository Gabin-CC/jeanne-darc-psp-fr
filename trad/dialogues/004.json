 },
 {
  "ctx": "ST1060BT",
  "max": 16,
  "who": "Man's Voice",
  "en": "Lights of war, cast your rays \ndown upon me!",
  "fr": "Lumières guerrières\n! Illuminez-moi !",
  "src": "pinky"
 },
 {
  "ctx": "ST1060BT",
  "max": 16,
  "who": "Gilles",
  "en": "Lord above, thank you for \nguiding me to my friends.",
