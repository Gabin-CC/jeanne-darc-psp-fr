  "src": "pinky"
 },
 {
  "ctx": "ST1060AB",
  "max": 34,
  "who": "Gilles",
  "en": "Come join me in Chinon \nwhen you're ready. \nSafe journey, Jeanne.",
  "fr": "Rejoignez-moi à Chinon\nquand vous serez prête. \fBonne route, Jeanne.",
  "src": "pinky",
  "relu": true
 },
 {
  "ctx": "ST1060AB",
  "max": 34,
  "who": "Jeanne",
  "en": "...All right.\nYou too, Gilles.",
